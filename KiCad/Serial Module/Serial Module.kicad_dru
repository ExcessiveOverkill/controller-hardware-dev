(version 1)
# JLCPCB standard (no extra cost) capabilities, 6-layer 1.6 mm, 1 oz outer / nominal 0.5 oz inner.
# Board Setup holds the global minimums; these rules cover what it cannot express.

(rule "JLC via: 0.2 mm drill needs >= 0.45 mm pad"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.2mm))
	(constraint via_diameter (min 0.45mm)))

(rule "JLC PTH annular ring >= 0.15 mm"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.15mm)))

(rule "JLC NPTH >= 0.5 mm"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.5mm)))

(rule "JLC PTH hole to copper >= 0.28 mm"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.28mm)))

(rule "JLC pad hole to hole >= 0.45 mm"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.isPlated() && B.isPlated()")
	(constraint hole_to_hole (min 0.45mm)))

(rule "JLC SMD pad to pad >= 0.15 mm (different nets)"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.Net != B.Net")
	(constraint clearance (min 0.15mm)))

(rule "JLC silkscreen to pad >= 0.15 mm"
	(layer "?.Silkscreen")
	(constraint silk_clearance (min 0.15mm)))

(rule "In1.Cu reserved for ground copper fill"
	(layer "In1.Cu")
	(constraint disallow track))

(rule "In4.Cu reserved for power copper fills"
	(layer "In4.Cu")
	(constraint disallow track))
